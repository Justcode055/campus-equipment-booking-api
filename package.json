{
  "name": "campus-equipment-booking-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev": "node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "node tests/http.test.ts",
